\setbeamercolor{alerted text}{fg=carmine}

\newenvironment{proslist}{%
    \begin{itemize}\setbeamertemplate{itemize item}{\textcolor{oxfordblue}{\ding{51}}}%
}{\end{itemize}}
\newenvironment{conslist}{%
    \begin{itemize}\setbeamertemplate{itemize item}{\textcolor{carmine}{\ding{55}}}%
}{\end{itemize}}
